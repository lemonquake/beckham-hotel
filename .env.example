# Discord Bot Configuration Template
# Created by Aljay Leodones for Beckham Hotel

# Your Discord Bot Token from the Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Specific Discord Server (Guild) ID for instant slash command registration during development
GUILD_ID=

# Channel where formal member engagement reports are published
REPORT_CHANNEL_ID=

# Timezone used to interpret custom report dates and footer timestamps (IANA name)
REPORT_TIMEZONE=Asia/Manila

# Optional path for the local activity database
ACTIVITY_DATABASE_PATH=data/engagement.sqlite3

# Optional path for the onboarding / growth database
COMMUNITY_DATABASE_PATH=data/community.sqlite3

# Optional folder for banner and message pictures uploaded from the Mod Panel.
# They are kept locally so a saved announcement still has its banner long
# after the Discord link it came from has expired.
BANNER_ASSET_PATH=data/banners

# -- Engagement contest -----------------------------------------------------
# Channel where the Top 15 contest leaderboard is published
CONTEST_REPORT_CHANNEL_ID=

# Point weighting
CONTEST_POINTS_MESSAGE=2
CONTEST_POINTS_REACTION=1
CONTEST_POINTS_TIKTOK=10

# Genuine-message rules (leave these alone unless the contest rules change)
# Minimum real words a message needs, once links/mentions/emoji are stripped
CONTEST_MIN_MESSAGE_WORDS=3
# The same person repeating the same text inside this many hours scores once
CONTEST_SELF_REPEAT_HOURS=24
# Identical text copied between people inside this many minutes scores once
CONTEST_CROSS_REPEAT_MINUTES=60
# Minimum seconds between two scoring messages from the same person
CONTEST_MESSAGE_COOLDOWN_SECONDS=10
# How many past contests the history browser lists at once
CONTEST_HISTORY_LIMIT=25

# ── Onboarding channels (optional) ─────────────────────────────────────────
# These are only starting values. Moderators can set them in Discord with
# Mod Panel -> Onboarding -> Channel setup, and those choices always win.
# Where the welcome post goes (and where new members introduce themselves)
WELCOME_CHANNEL_ID=1551941518426771466
INTRODUCTIONS_CHANNEL_ID=1551941518426771466
# Product Info channel linked in every welcome
ONBOARDING_CHANNEL_ID=1552014138333593620

# How far back the onboarding scanner looks for members never welcomed (days)
ONBOARDING_LOOKBACK_DAYS=30

# Members with any of these roles are never picked up by the onboarding scan
ONBOARDING_EXCLUDED_ROLE_IDS=1549192583203262464,1549415196123074581,1549415069031600279

# Creator onboarding (the TikTok Shop question). Also settable in Discord with
# Mod Panel -> Onboarding -> Settings.
#   CREATOR_WELCOME_CHANNEL_ID          default channel for the public welcome post
#   CREATOR_GETTING_STARTED_CHANNEL_ID  information channel - where 🌱 creators are sent
#   CREATOR_SUPPORT_CHANNEL_ID          support-ticket channel linked in the rules
CREATOR_WELCOME_CHANNEL_ID=
CREATOR_GETTING_STARTED_CHANNEL_ID=1553106965922578595
CREATOR_SUPPORT_CHANNEL_ID=1549416221995307058

# Beckham Onboarding: the category the private <handle>-onboarding channels are
# created in, and the role granted when a member finishes onboarding. Also
# settable from Mod Panel -> Beckham Onboarding -> Settings.
BECKHAM_ONBOARDING_CATEGORY_ID=1559567789948141710
BECKHAM_ONBOARDING_ROLE_ID=1559568207495303279

# ── Community reports ──────────────────────────────────────────────────────
# How often deployed live reports refresh themselves (hours)
REPORT_REFRESH_HOURS=3

# Set to false if the Presence Intent is switched off in the Developer Portal.
# The bot also detects this automatically and starts without it.
ENABLE_PRESENCE_INTENT=true

# ── Weekly announcement links ──────────────────────────────────────────────
# Used in the default announcement copy (editable later from the Mod Panel)
ANNOUNCEMENT_CONTEST_URL=https://creators.euka.ai
ANNOUNCEMENT_CONNECT_URL=https://creators.euka.ai

# Private incoming webhook for this brand's Slack data channel.
SLACK_ONBOARDING_WEBHOOK_URL=

# Opportunities channel linked after successful onboarding.
CREATOR_OPPORTUNITIES_CHANNEL_ID=1559622381302190181
